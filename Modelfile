## IMPLEMENTATION GUIDE (Option C — fabric-ctrl extension)

### File structure to add in git-fabric/fabric-ctrl:

  src/
    invoke/
      index.ts          — exports InvokeRouter class
      router.ts         — calls fabric-router Ollama model, parses route decision
      dispatcher.ts     — executes Ollama API calls per step
      sequences.ts      — embedded sequence registry (SEQ-01 through SEQ-06)
      aiana.ts          — AIANA recall and record wrappers
      types.ts          — InvokeRequest, InvokeResponse, RouteDecision, Step types

### router.ts — parse fabric-router output

  The fabric-router prompt outputs a structured block:
    ROUTE: k3s-ops
    SECONDARY: proxmox-ops, sandfly-ops
    SEQUENCE: SEQ-04
    REASON: Infrastructure health check...
    CONTEXT-PASS: ...

  Parse with regex or line-split. Extract each field.
  If parsing fails → default route: Claude (escalate with full query + error note).

### dispatcher.ts — Ollama API call

  async function callSpecialist(model: string, prompt: string): Promise<string> {
    const response = await fetch(`${OLLAMA_ENDPOINT}/api/generate`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        model,
        prompt,
        stream: false,
        options: { temperature: 0.15, num_ctx: 8192 }
      }),
      signal: AbortSignal.timeout(SPECIALIST_TIMEOUT_MS)
    })
    const data = await response.json()
    return data.response
  }

### aiana.ts — recall and record

  // Recall: check for prior context before dispatch
  async function recallContext(query: string, project?: string): Promise<string> {
    const res = await fetch(`${AIANA_ENDPOINT}/memory/search`, {
      method: 'POST',
      body: JSON.stringify({ query, project, limit: 5 })
    })
    const data = await res.json()
    if (!data.results?.length) return ''
    return data.results.map(r => r.content).join('\n')
  }

  // Record: save outcome after resolution
  async function recordOutcome(content: string, project?: string, tags: string[] = []) {
    await fetch(`${AIANA_ENDPOINT}/memory/add`, {
      method: 'POST',
      body: JSON.stringify({ content, project, tags, role: 'assistant' })
    })
  }

### Hono route addition in src/index.ts or src/routes/invoke.ts:

  app.post('/invoke', async (c) => {
    const body = await c.req.json() as InvokeRequest
    const result = await invokeRouter.handle(body)
    return c.json(result)
  })

